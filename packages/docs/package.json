{
  "name": "@praxis/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for praxis-vue-ui — built with VitePress",
  "type": "module",
  "scripts": {
    "docs:api": "node scripts/extract-api.mjs",
    "dev": "node scripts/extract-api.mjs && vitepress dev",
    "build": "cd ../editor && pnpm run build && cd ../docs && node scripts/extract-api.mjs && vitepress build",
    "preview": "vitepress preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^14.3.0",
    "praxis-vue-editor": "workspace:*",
    "vue": "^3.5.40",
    "vue-select": "4.0.0-beta.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.3",
    "vue-docgen-api": "^4.79.2",
    "workbox-window": "^7.4.1"
  }
}
