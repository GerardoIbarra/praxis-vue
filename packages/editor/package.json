{
  "name": "praxis-vue-editor",
  "version": "0.1.1",
  "description": "A premium Vue 3 rich-text editor component powered by Wordgard.",
  "keywords": [
    "vue",
    "vue3",
    "editor",
    "rich-text",
    "wordgard",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/praxis-editor.umd.cjs",
  "module": "./dist/praxis-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/praxis-editor.js",
      "require": "./dist/praxis-editor.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/praxis-editor.css": "./dist/praxis-editor.css",
    "./style.css": "./dist/praxis-editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "wordgard": "*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0"
  }
}
