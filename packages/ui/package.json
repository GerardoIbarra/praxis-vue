{
  "name": "praxis-vue-ui",
  "version": "0.1.3",
  "description": "A generic Vue 3 UI component library — forms, data-display, layout, navigation, overlays and more.",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/praxis-vue.umd.cjs",
  "module": "./dist/praxis-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/praxis-vue.js",
      "require": "./dist/praxis-vue.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/praxis-vue.css": "./dist/praxis-vue.css",
    "./style.css": "./dist/praxis-vue.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "pinia": "^4.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/vue-table": "^9.1.2",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.21",
    "libphonenumber-js": "^1.13.10",
    "lodash": "^4.18.1",
    "pdfjs-dist": "^6.2.108",
    "v-calendar": "^3.1.2",
    "vue-draggable-plus": "^0.6.1",
    "vue-select": "4.0.0-beta.6",
    "vue-tel-input": "^9.8.0"
  }
}
